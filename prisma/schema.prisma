generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CONSULTANT
  ADMIN
}

enum AnalysisStatus {
  PENDING
  READY
  NEEDS_REVIEW
  APPROVED
}

enum SimulationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum SimulationType {
  COLOR_DRAPE
  BLOUSE_TONE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(USER)
  lgpdConsentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  analyses       Analysis[]
  reviews        ConsultantReview[] @relation("Reviewer")
  simulationJobs SimulationJob[]
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeasonPalette {
  id          String   @id
  namePt      String
  nameEn      String
  temperature String
  value       String
  chroma      String
  description String
  useColors   Json
  avoidColors Json
  clothing    Json
  lipstick    Json
  eyeshadow   Json
  base        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses         Analysis[]         @relation("PredictedSeason")
  overrideAnalyses Analysis[]         @relation("OverrideSeason")
  reviews          ConsultantReview[]
}

model Analysis {
  id                 String         @id @default(cuid())
  userId             String
  imagePath          String
  status             AnalysisStatus @default(PENDING)
  seasonId           String?
  overrideSeasonId   String?
  confidence         Float?
  features           Json?
  photoQuality       Json?
  undertoneLabel     String?
  recommendations    Json?
  context            String         @default("casual")
  consultantApproved Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  season         SeasonPalette?     @relation("PredictedSeason", fields: [seasonId], references: [id])
  overrideSeason SeasonPalette?     @relation("OverrideSeason", fields: [overrideSeasonId], references: [id])
  reviews        ConsultantReview[]
  simulations    SimulationJob[]

  @@index([userId, createdAt])
  @@index([status])
}

model ConsultantReview {
  id               String   @id @default(cuid())
  analysisId       String
  reviewerId       String
  overrideSeasonId String?
  notes            String?
  approved         Boolean  @default(true)
  createdAt        DateTime @default(now())

  analysis       Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  reviewer       User           @relation("Reviewer", fields: [reviewerId], references: [id])
  overrideSeason SeasonPalette? @relation(fields: [overrideSeasonId], references: [id])

  @@index([analysisId])
}

model SimulationJob {
  id             String           @id @default(cuid())
  userId         String
  analysisId     String
  type           SimulationType
  targetColorHex String
  status         SimulationStatus @default(QUEUED)
  provider       String           @default("mock")
  providerJobId  String?
  inputPath      String
  outputPath     String?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}
