# PostgreSQL (local via docker compose)
DATABASE_URL="postgresql://colometria:colometria@localhost:5433/colometria?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo"
AUTH_URL="http://localhost:3000"

# Storage local de imagens (fora do public/)
UPLOAD_DIR="uploads"

# Simulação visual — Hugging Face Inference Providers
VTO_PROVIDER="huggingface"
# Token: https://huggingface.co/settings/tokens
# Fine-grained com “Make calls to Inference Providers”
HF_TOKEN=""
# HF_VTO_MODEL="black-forest-labs/FLUX.1-Kontext-dev"

VTO_DAILY_LIMIT="5"
# E-mails sem limite diário (separados por vírgula)
VTO_UNLIMITED_EMAILS=""

# Visão / colorimetria
FACE_DETECTOR="blazeface"
COLOR_PREDICTOR="rules"
PHOTO_RETENTION_DAYS="365"
