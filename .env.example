# PostgreSQL (local via docker compose)
DATABASE_URL="postgresql://colometria:colometria@localhost:5433/colometria?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo"
AUTH_URL="http://localhost:3000"

# Storage local de imagens (fora do public/)
UPLOAD_DIR="uploads"

# Simulação VTO (opcional — sem chave, usa mock local)
FAL_KEY=""
VTO_PROVIDER="mock"

# Limite de simulações por usuária / dia
VTO_DAILY_LIMIT="5"

# Visão / IA colorimetria (docs/architecture/colorimetry-ml.md)
# heuristic = default sem deps extras; blazeface = TF.js (recomendado pós-decisão)
FACE_DETECTOR="blazeface"
# rules = árvore atual; tabular-v1 = modelo treinado (quando ativo)
COLOR_PREDICTOR="rules"
# Retenção biométrica (dias) — npm run retention:purge [-- --dry-run] [-- --days=90]
PHOTO_RETENTION_DAYS="365"
